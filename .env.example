# Firebase settings for online play. Copy to .env.local for local testing, and add the same
# names under Vercel → Project → Settings → Environment Variables for the live site.
# Leave them empty to run the game in solo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
