; Driftwood Isles: Godot port (world, player, water, sky). Open this folder in Godot 4.4 or newer.
config_version=5

[application]

config/name="Driftwood Isles"
config/description="The Driftwood Isles world and player angler, exported from the web game."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
